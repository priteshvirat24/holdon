# Copy to .env.local and fill in. Everything except PayPal is optional:
# without a key, that feature falls back (and the UI says so).

# ── PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Set after registering the webhook (POST /api/paypal/setup-webhook with your public https URL)
PAYPAL_WEBHOOK_ID=
# Sandbox PERSONAL account emails (Sandbox → Accounts). Mom's receives the allowance Payout.
PAYPAL_SANDBOX_MOM_EMAIL=
PAYPAL_SANDBOX_PRIYA_EMAIL=
PAYPAL_SANDBOX_ANIL_EMAIL=
PAYPAL_SANDBOX_RAJ_EMAIL=

# ── Mistral (console.mistral.ai). Models: ministral-8b / ministral-14b / mistral-large-4 ──
MISTRAL_API_KEY=

# ── Channel3 (channel3.ai, promo PAYPAL-HACKATHON-2026): real market prices ──
CHANNEL3_API_KEY=

# ── Telegram (optional; the web family chat always works) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_FAMILY_CHAT_ID=

# ── Deployment ──
# Postgres connection string (Render). Leave empty locally: embedded Postgres (PGlite) in .data/
DATABASE_URL=
APP_URL=http://localhost:3000
CRON_SECRET=change-me
