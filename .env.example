# HoldOn local secrets. This file is git-ignored. Never commit it.
# Paste values after the =

# ── PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox → your app) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Filled in later, after we register the webhook:
PAYPAL_WEBHOOK_ID=

# ── Optional now, needed later ──
# Channel3 (channel3.ai → dashboard; promo PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=
# Telegram (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Mistral: leave blank to use the key already in ~/.config/officevault/mistral.env
MISTRAL_API_KEY=
